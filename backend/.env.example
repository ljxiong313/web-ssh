# WebSSH 后端环境变量模板：复制为 backend/.env 并填入真实值（勿提交真实密钥）

# ── 必填 ──
JWT_SECRET=change-me-at-least-32-characters
ENCRYPTION_KEY=change-me-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:37580,http://localhost:37581

# ── 可选 ──
DATA_DIR=./data              # SQLite 数据库与终端录像等数据文件的存放目录
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=                # 缺省取 ALLOWED_ORIGINS 首项
MVP_MODE=false               # true 会绕过 CORS/RBAC 校验，仅用于本地预览，禁止用于生产

# 数据库固定为 SQLite；如需 PostgreSQL / MySQL 请自行扩展 backend/db。
